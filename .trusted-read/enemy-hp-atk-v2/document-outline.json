    },
    {
      "paragraphId": "P00051",
      "path": "tabs.t.0.body.content[16].table.rows[10].cells[2].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1119,
      "endIndex": 1133,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
