{
  "name": "arknights-skill-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\" \"tests/*.test.mjs\"",
    "generate:module-colors": "node --experimental-strip-types scripts/generateModuleColorExample.mjs",
    "generate:enemy-histogram-counts": "node scripts/generateEnemyHistogramCounts.mjs",
    "generate:enemy-stages": "node --use-system-ca scripts/generateEnemyStageAppearances.mjs",
    "archive:enemy-aggregation": "node --experimental-strip-types scripts/enemyAggregationArchive.mjs",
    "generate:maps": "node scripts/generateMapDatabase.mjs",
    "generate:roguelike": "node --use-system-ca scripts/generateRoguelikeDatabase.mjs",
    "generate:main-enemy-trends": "node --experimental-strip-types scripts/generate-main-enemy-trends.mjs",
    "preview": "vite preview",
    "rules:check": "node scripts/sync-project-rules.mjs check",
    "rules:diff": "node scripts/sync-project-rules.mjs diff",
    "rules:sync": "node scripts/sync-project-rules.mjs sync"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "html-to-image": "1.11.13",
    "iced-x86": "1.21.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
